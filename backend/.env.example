# Postgres (local docker-compose por default; en AWS apunta a RDS)
DATABASE_URL="postgresql://planify:planify@localhost:5432/planify?schema=public"

# Servidor
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="7d"

# Cognito (Sprint 3 — auth completa, no usado en el MVP)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

# SNS/Pinpoint (notificaciones — Sprint 3)
SNS_TOPIC_ARN=

# Gemini API (SCRUM-17 — IA de auto-generación de eventos)
GEMINI_API_KEY=
