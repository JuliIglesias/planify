# Postgres (local docker-compose por default; en AWS apunta a RDS)
DATABASE_URL="postgresql://planify:planify@localhost:5432/planify?schema=public"

# Servidor
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET="cambiar-en-produccion"
JWT_EXPIRES_IN="7d"

# Cognito (Sprint 3 — auth completa, no usado en el MVP)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

# SNS/Pinpoint (notificaciones — Sprint 3)
SNS_TOPIC_ARN=

# S3 — imágenes (foto de grupo, Tanda 6 Item 5).
# En AWS real: dejar AWS_S3_ENDPOINT vacío (usa el endpoint público de S3) y
# cargar credenciales reales (o un rol de IAM en el propio EC2, sin env vars).
# En local (docker-compose): apunta a LocalStack, el "homónimo" S3-compatible.
AWS_S3_BUCKET=planify-dev
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Gemini API (SCRUM-17 — IA de auto-generación de eventos)
GEMINI_API_KEY=
