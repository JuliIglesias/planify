// Planify — modelo de datos
// Ver docs/01-plan-de-ejecucion.md §3 para el diagrama ER y las notas de negocio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventoEstado {
  planificacion
  confirmado
  cancelado
  finalizado
}

enum AsistenciaEstado {
  sin_confirmar
  confirmado
  rechazado
}

enum TareaEstado {
  no_asignado
  pendiente
  completado
}

enum DeudaEstado {
  pagar
  pendiente
  saldado
}

enum AmistadEstado {
  pendiente
  aceptada
}

model Usuario {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String   @map("password_hash")
  avatarUrl       String?  @map("avatar_url")
  idiomaPreferido String   @default("es") @map("idioma_preferido")
  createdAt       DateTime @default(now()) @map("created_at")

  miembroGrupo      MiembroGrupo[]
  participaciones   Participante[]
  amistadesEnviadas Amistad[]      @relation("AmistadUsuario1")
  amistadesRecibidas Amistad[]     @relation("AmistadUsuario2")
  disponibilidadPerfil DisponibilidadPerfil[]
  ubicacionesFavoritas UbicacionFavorita[]

  @@map("usuarios")
}

model Grupo {
  id        String   @id @default(uuid())
  nombre    String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  miembros MiembroGrupo[]
  eventos  Evento[]

  @@map("grupos")
}

model MiembroGrupo {
  id         String   @id @default(uuid())
  grupoId    String   @map("grupo_id")
  usuarioId  String   @map("usuario_id")
  fechaUnion DateTime @default(now()) @map("fecha_union")

  grupo   Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@map("miembros_grupo")
}

model Evento {
  id             String       @id @default(uuid())
  grupoId        String       @map("grupo_id")
  nombre         String
  lugarTexto     String       @map("lugar_texto")
  estado         EventoEstado @default(planificacion)
  fechaHoraInicio DateTime?   @map("fecha_hora_inicio")
  // Item 1 (Fase 5): rango de fechas calendario dentro del cual se busca el
  // horario. El heatmap semanal se recorta a este rango, no es indefinido.
  rangoInicio      DateTime @map("rango_inicio")
  rangoFin         DateTime @map("rango_fin")
  // Cuántas veces se extendió el rango automáticamente (2 semanas c/u) por
  // vencer sin horario confirmado. Tope 1: a partir de ahí el organizador
  // decide manualmente (ver docs/adrs/0001-rango-fechas-evento.md).
  extensionesRango Int      @default(0) @map("extensiones_rango")
  // Item 5 (Fase 5): el horario confirmado es un RANGO, no un instante — el
  // organizador fija inicio y fin (ver docs/adrs/0002-rango-horario-evento.md).
  fechaHoraFin    DateTime?   @map("fecha_hora_fin")
  creadoPor      String       @map("creado_por") // participante_id del organizador
  createdAt      DateTime     @default(now()) @map("created_at")

  grupo         Grupo                @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  participantes Participante[]
  invitaciones  Invitacion[]
  disponibilidad DisponibilidadSlot[]
  tareas        Tarea[]
  gastos        Gasto[]
  deudas        DeudaSimplificada[]
  logActividad  LogActividad[]

  @@map("eventos")
}

model Participante {
  id               String            @id @default(uuid())
  eventoId         String            @map("evento_id")
  usuarioId        String?           @map("usuario_id") // null si es anónimo
  // Sin @@unique a nivel tabla a propósito: un usuario registrado participa
  // de varios eventos y repite legítimamente su username en cada fila. La
  // unicidad real (entre anónimos, y contra Usuario.username) se valida en
  // ParticipantsService antes de insertar — Postgres no soporta un índice
  // único parcial (solo para es_anonimo=true) declarado en este schema.
  username         String
  esAnonimo        Boolean           @default(false) @map("es_anonimo")
  esOrganizador    Boolean           @default(false) @map("es_organizador")
  tokenSesion      String?           @unique @map("token_sesion") // solo si es_anonimo
  estadoAsistencia AsistenciaEstado  @default(sin_confirmar) @map("estado_asistencia")
  ultimaLecturaAt  DateTime?         @map("ultima_lectura_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  evento         Evento               @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario        Usuario?             @relation(fields: [usuarioId], references: [id])
  disponibilidad DisponibilidadSlot[]
  tareasCreadas  Tarea[]              @relation("TareaCreador")
  tareasAsignadas Tarea[]             @relation("TareaAsignado")
  gastosCreados  Gasto[]
  aportes        GastoAcreedor[]
  deudasComoDeudor    DeudaSimplificada[] @relation("DeudorParticipante")
  deudasComoAcreedor  DeudaSimplificada[] @relation("AcreedorParticipante")
  logsGenerados  LogActividad[]
  gastoDeudor    GastoDeudor[]

  @@map("participantes")
}

model Invitacion {
  id           String    @id @default(uuid())
  eventoId     String    @map("evento_id")
  tokenUnico   String    @unique @map("token_unico")
  expiraEn     DateTime? @map("expira_en")
  usosMaximos  Int?      @map("usos_maximos")

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("invitaciones")
}

model DisponibilidadSlot {
  id             String @id @default(uuid())
  participanteId String @map("participante_id")
  eventoId       String @map("evento_id")
  diaSemana      Int    @map("dia_semana") // 0=lunes .. 6=domingo
  bloqueHora     Int    @map("bloque_hora") // ej. 0..47 (bloques de 30 min)

  participante Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  evento       Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([participanteId, eventoId, diaSemana, bloqueHora])
  @@map("disponibilidad_slots")
}

model Tarea {
  id         String      @id @default(uuid())
  eventoId   String      @map("evento_id")
  titulo     String
  estado     TareaEstado @default(no_asignado)
  asignadoA  String?     @map("asignado_a")
  creadoPor  String      @map("creado_por")
  createdAt  DateTime    @default(now()) @map("created_at")

  evento    Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  asignado  Participante? @relation("TareaAsignado", fields: [asignadoA], references: [id])
  creador   Participante  @relation("TareaCreador", fields: [creadoPor], references: [id])

  @@map("tareas")
}

model Gasto {
  id          String   @id @default(uuid())
  eventoId    String   @map("evento_id")
  descripcion String
  montoTotal  Decimal  @map("monto_total") @db.Decimal(12, 2)
  creadoPor   String   @map("creado_por")
  fecha       DateTime @default(now())

  evento    Evento          @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  creador   Participante    @relation(fields: [creadoPor], references: [id])
  acreedores GastoAcreedor[]
  deudores  GastoDeudor[]

  @@map("gastos")
}

model GastoAcreedor {
  id             String  @id @default(uuid())
  gastoId        String  @map("gasto_id")
  participanteId String  @map("participante_id")
  montoAportado  Decimal @map("monto_aportado") @db.Decimal(12, 2)

  gasto        Gasto        @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  participante Participante @relation(fields: [participanteId], references: [id])

  @@map("gasto_acreedores")
}

model GastoDeudor {
  id             String  @id @default(uuid())
  gastoId        String  @map("gasto_id")
  participanteId String  @map("participante_id")
  montoAdeudado  Decimal @map("monto_adeudado") @db.Decimal(12, 2)

  gasto        Gasto        @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  participante Participante @relation(fields: [participanteId], references: [id])

  @@map("gasto_deudores")
}

model DeudaSimplificada {
  id                    String      @id @default(uuid())
  eventoId              String      @map("evento_id")
  deudorParticipanteId  String      @map("deudor_participante_id")
  acreedorParticipanteId String     @map("acreedor_participante_id")
  monto                 Decimal     @db.Decimal(12, 2)
  estado                DeudaEstado @default(pendiente)
  saldadoEn              DateTime?  @map("saldado_en")

  evento   Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  deudor   Participante @relation("DeudorParticipante", fields: [deudorParticipanteId], references: [id])
  acreedor Participante @relation("AcreedorParticipante", fields: [acreedorParticipanteId], references: [id])

  @@map("deudas_simplificadas")
}

model LogActividad {
  id                 String   @id @default(uuid())
  eventoId           String   @map("evento_id")
  tipo               String
  actorParticipanteId String  @map("actor_participante_id")
  payload            Json?
  createdAt          DateTime @default(now()) @map("created_at")

  evento Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  actor  Participante @relation(fields: [actorParticipanteId], references: [id])

  @@map("log_actividad")
}

model Amistad {
  id         String        @id @default(uuid())
  usuarioId1 String        @map("usuario_id_1")
  usuarioId2 String        @map("usuario_id_2")
  estado     AmistadEstado @default(pendiente)
  createdAt  DateTime      @default(now()) @map("created_at")

  usuario1 Usuario @relation("AmistadUsuario1", fields: [usuarioId1], references: [id], onDelete: Cascade)
  usuario2 Usuario @relation("AmistadUsuario2", fields: [usuarioId2], references: [id], onDelete: Cascade)

  @@unique([usuarioId1, usuarioId2])
  @@map("amistades")
}

// H-14 — disponibilidad semanal de perfil (por usuario, no por evento).
// Sirve para pre-llenar la del evento y para las coincidencias entre amigos (HU-B4).
model DisponibilidadPerfil {
  id         String @id @default(uuid())
  usuarioId  String @map("usuario_id")
  diaSemana  Int    @map("dia_semana")
  bloqueHora Int    @map("bloque_hora")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, diaSemana, bloqueHora])
  @@map("disponibilidad_perfil")
}

// HU-B5 — ubicaciones usuales guardadas como favoritas, reutilizables al crear eventos.
model UbicacionFavorita {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  etiqueta  String
  texto     String
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("ubicaciones_favoritas")
}
